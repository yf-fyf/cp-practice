% 自由課題の最小雛形の入力データ（MiniZinc）
%
% 最小インスタンスは「紙の上で答えを1つ作れる大きさ」にする。
% 企画書の節6に書き下した数値を、ここへ写す。
% 数独なら 4×4、勤務表なら 4人・3日 がこの水準にあたる。

n = 4;                               % 決める対象の数
k = 2;                               % 各対象が取り得る値の数

name = ["A", "B", "C", "D"];         % 対象の名前（n 個）

% パラメータを足すときは、model.mzn 側にも同じ名前の宣言を足す。
% 例:
% cap = [2, 2];                      % 値ごとの上限（k 個）
% forbidden = array2d(1..n, 1..k, [false, false, false, false,
%                                  false, false, false, false]);
