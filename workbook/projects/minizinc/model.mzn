% 自由課題の最小雛形（MiniZinc）
%
% 教材ページ: 自由課題 > 第12回 最小実行モデル
% 使い方:     このファイルと data.dzn を MiniZinc Playground で開いて実行する。
%             そのままでも動く（制約が1本も無いので、どんな解でも返る）。
%             まず動かしてから、TODO(1) の制約を1本ずつ足していく。
%
% 変数の取り方はこの形でなくてよい。ここでは「対象ごとに値を1つ決める」
% いちばん素直な形にしてある。組ごとに真偽で持つ表現にするなら、
% var VAL を array[OBJ, VAL] of var bool に置き換える。

% ── 入力（data.dzn から来る）─────────────────────────────
int: n;                              % 決める対象の数
int: k;                              % 各対象が取り得る値の数
array[1..n] of string: name;         % 対象の名前（出力を読みやすくするため）

set of int: OBJ = 1..n;
set of int: VAL = 1..k;

% ── 決定変数と定義域 ────────────────────────────────────
% この宣言だけで「1つの対象に値は1つ」は保証されている。
% その条件を制約として書く必要はない。
array[OBJ] of var VAL: x;

% ── ハード制約 ──────────────────────────────────────────
% TODO(1) 企画書の H1 から順に、1本ずつ足す。
%         1本足すたびに実行して、解が減ったか・形が変わったかを見る。
%         期待どおりでなければ、いま足した1本を疑う。ほかを疑わない。
%
%         書き方の例（企画書の番号をコメントに残しておくと後で追える）:
%
% % H1. 同じ値を2つの対象に割り当てない
% constraint all_different(x);          % include "globals.mzn"; が要る
%
% % H2. 対象 1 と対象 2 は違う値にする
% constraint x[1] != x[2];
%
% % H3. どの値も、使われる回数は 2 回までにする
% constraint forall(v in VAL) ( count(x, v) <= 2 );

% ── ソフト制約と目的 ────────────────────────────────────
% TODO(2) 目的が無い問題は solve satisfy のままでよい。
%         目的があるなら、ペナルティを数えてから最小化する。
%
% var int: penalty = sum(i in OBJ) ( bool2int(x[i] != 1) );
% solve minimize penalty;

solve satisfy;

% ── 出力 ────────────────────────────────────────────────
% 人が読む行と、検証器が読む行（# で始まる行）の両方を出す。
% verify.py はこの # の行だけを読む。
% 名前は ++ でつなぐ。\(name[i]) と書くと引用符付きの "A" になってしまう。
output
  [ "#size \(n) \(k)\n" ] ++
  [ "#assign " ++ name[i] ++ " \(x[i])\n" | i in OBJ ] ++
  [ "\n" ] ++
  [ name[i] ++ " -> \(x[i])\n" | i in OBJ ];
% 目的関数を足したら、#value の行も出しておく（検証器が数え直して突き合わせる）。
% 上の output の最後の ; の前に、次の1行を足す。
%   ++ [ "#value penalty \(penalty)\n" ]
