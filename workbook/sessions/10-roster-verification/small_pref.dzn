% 第10回 基礎データ — 4人・3日 + 希望休
%
% 第09回の small_pref.dzn と同じ内容である。重み w_night だけ、
% 第09回の標準演習を終えた状態（3項）に合わせて 1 にしてある。
%
% 第08回の small.dzn に、希望休 want_off と3つの重みを足したものである。
% ハード制約に関わる値は第08回とまったく同じである。
%
% この科目のために作った架空のデータである。実在する職場の希望調査ではない。
% ハード制約を満たす勤務表はこの規模だと6通りしかないので、手でも数え上げられる。

ns = 4;
nd = 3;

sname = ["A", "B", "C", "D"];

leader = [true, false, true, false];

%              1日 2日 3日
need_day   = [  2,  2,  2 ];
need_night = [  1,  1,  1 ];

% 希望休。職員Aが1日目と3日目、職員Cが2日目を希望している。
%                        1日    2日    3日
want_off = array2d(1..4, 1..3,
  [ true , false, true     % 職員A
  , false, false, false    % 職員B
  , false, true , false    % 職員C
  , false, false, false    % 職員D
  ]);

% 重み。ここを書き換えて、解がどう変わるかを見る。
w_pref  = 10;      % 希望休違反1件あたり
w_fair  = 1;       % 勤務日数の偏り1あたり
w_night = 1;       % 夜勤回数の偏り1あたり
