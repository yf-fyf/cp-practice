% 第10回 規模拡大データ — 8人・14日 + 希望休
%
% week_pref.dzn（8人・7日）を2週間に伸ばしたものである。
% 職員・資格・必要人数の決め方はまったく同じで、**日数だけが2倍**になっている。
% 変えたのが日数だけなので、実行時間の違いを規模のせいだと言い切れる。
%
% この科目のために作った架空のデータである。実在する職場の希望調査ではない。

ns = 8;
nd = 14;

sname = ["A", "B", "C", "D", "E", "F", "G", "H"];

leader = [true, false, false, true, false, true, false, false];

%             1日 2日 3日 4日 5日 6日 7日 8日 9日 10日 11日 12日 13日 14日
need_day   = [  3,  3,  3,  3,  3,  2,  2,  3,  3,  3,  3,  3,  2,  2 ];
need_night = [  2,  2,  2,  2,  2,  2,  2,  2,  2,  2,  2,  2,  2,  2 ];

% 希望休。1週目は week_pref.dzn と同じで、2週目を足してある。
%                        1日    2日    3日    4日    5日    6日    7日    8日    9日   10日   11日   12日   13日   14日
want_off = array2d(1..8, 1..14,
  [ false, false, false, false, false, true , true , false, false, false, false, false, true , true    % 職員A
  , false, false, false, false, false, true , true , false, false, true , false, false, false, false   % 職員B
  , false, false, true , false, false, false, false, false, false, false, true , false, false, false   % 職員C
  , false, false, false, false, true , false, false, false, false, false, false, true , false, false   % 職員D
  , false, false, false, false, false, false, true , false, true , false, false, false, false, false   % 職員E
  , true , false, false, false, false, false, false, false, false, false, false, false, true , true    % 職員F
  , false, false, false, true , false, false, false, false, false, false, false, true , false, false   % 職員G
  , true , true , true , true , false, false, false, true , true , true , true , false, false, false   % 職員H
  ]);

% 重み。week_pref.dzn と同じ3項の設定である。
w_pref  = 10;      % 希望休違反1件あたり
w_fair  = 1;       % 勤務日数の偏り1あたり
w_night = 1;       % 夜勤回数の偏り1あたり
