% 第09回 標準データ — 8人・7日 + 希望休
%
% 第08回の week.dzn に、希望休 want_off と3つの重みを足したものである。
% ハード制約に関わる値（ns / nd / sname / leader / need_day / need_night）は
% 第08回とまったく同じである。
%
% この科目のために作った架空のデータである。実在する職場の希望調査ではない。

ns = 8;
nd = 7;

sname = ["A", "B", "C", "D", "E", "F", "G", "H"];

leader = [true, false, false, true, false, true, false, false];

%              1日 2日 3日 4日 5日 6日 7日
need_day   = [  3,  3,  3,  3,  3,  2,  2 ];
need_night = [  2,  2,  2,  2,  2,  2,  2 ];

% 希望休。true の日は「その日は休みたい」という申し出である。
% 職員Hは1日目から4日目までの連休を、職員Aと職員Bは週末（6日目・7日目）を希望している。
%                        1日    2日    3日    4日    5日    6日    7日
want_off = array2d(1..8, 1..7,
  [ false, false, false, false, false, true , true    % 職員A
  , false, false, false, false, false, true , true    % 職員B
  , false, false, true , false, false, false, false   % 職員C
  , false, false, false, false, true , false, false   % 職員D
  , false, false, false, false, false, false, true    % 職員E
  , true , false, false, false, false, false, false   % 職員F
  , false, false, false, true , false, false, false   % 職員G
  , true , true , true , true , false, false, false   % 職員H
  ]);

% 重み。ここを書き換えて、解がどう変わるかを見る。
w_pref  = 10;      % 希望休違反1件あたり
w_fair  = 1;       % 勤務日数の偏り1あたり
w_night = 0;       % 夜勤回数の偏り1あたり（標準演習で 1 にする）
