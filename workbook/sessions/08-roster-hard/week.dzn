% 第08回 標準データ — 8人・7日
%
% この科目のために作った架空のデータである。実在する職場の勤務表ではない。
% 6日目・7日目は日勤の必要人数が少ない（週末という想定）。
% 夜勤は毎日2名で、そのうち1名以上がリーダー資格を持つ必要がある。

ns = 8;
nd = 7;

sname = ["A", "B", "C", "D", "E", "F", "G", "H"];

% リーダー資格を持つのは職員A・職員D・職員Fの3人である。
leader = [true, false, false, true, false, true, false, false];

%              1日 2日 3日 4日 5日 6日 7日
need_day   = [  3,  3,  3,  3,  3,  2,  2 ];
need_night = [  2,  2,  2,  2,  2,  2,  2 ];
