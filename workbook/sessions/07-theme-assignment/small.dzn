% 第07回 基礎データ — 6人・3テーマ・定員2
%
% この科目のために作った架空のデータである。実在の希望調査ではない。
% 6人 × 定員2 × 3テーマ なので、どのテーマもちょうど定員まで埋まる。

ns  = 6;
nt  = 3;
cap = 2;

tname = ["テーマA", "テーマB", "テーマC"];

% 順位から得点への変換。第1希望を3点、第2希望を2点、第3希望を1点とする。
point = [3, 2, 1];

% 希望順位。1行が1人、列がテーマA・B・C の順。値は「第何希望か」。
%         A  B  C          第1希望 / 第2希望
rank = [| 1, 2, 3          % 1番: A / B
        | 1, 2, 3          % 2番: A / B
        | 1, 3, 2          % 3番: A / C
        | 2, 1, 3          % 4番: B / A
        | 3, 2, 1          % 5番: C / B
        | 3, 1, 2 |];      % 6番: B / C
