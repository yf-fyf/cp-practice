% 第07回 標準データ — 12人・4テーマ・定員3
%
% この科目のために作った架空のデータである。実在の希望調査ではない。
% 12人 × 定員3 × 4テーマ なので、どのテーマもちょうど定員まで埋まる。
% テーマD を第1希望にした人が5人いて、定員3 を超えている。

ns  = 12;
nt  = 4;
cap = 3;

tname = ["テーマA", "テーマB", "テーマC", "テーマD"];

% 順位から得点への変換。第4希望は0点とする。
point = [3, 2, 1, 0];

% 希望順位。1行が1人、列がテーマA・B・C・D の順。値は「第何希望か」。
%         A  B  C  D        第1希望 / 第2希望
rank = [| 2, 1, 3, 4        %  1番: B / A
        | 2, 1, 3, 4        %  2番: B / A
        | 3, 4, 2, 1        %  3番: D / C
        | 3, 2, 1, 4        %  4番: C / B
        | 4, 2, 1, 3        %  5番: C / B
        | 3, 4, 2, 1        %  6番: D / C
        | 1, 2, 4, 3        %  7番: A / B
        | 3, 4, 2, 1        %  8番: D / C
        | 3, 2, 1, 4        %  9番: C / B
        | 3, 4, 2, 1        % 10番: D / C
        | 3, 4, 2, 1        % 11番: D / C
        | 2, 1, 3, 4 |];    % 12番: B / A
